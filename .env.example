# ManSantulan (मन संतुलन) — Environment Configuration Template
PROJECT_NAME="ManSantulan Mental Wellness Platform"
ENVIRONMENT="development"
DEBUG=True

# Security & Authentication
SECRET_KEY="mansantulan_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (SQLite default, can upgrade to postgresql://user:pass@host/dbname)
DATABASE_URL="sqlite:///./mansantulan.db"

# CORS Configuration (comma separated)
BACKEND_CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"

# Rate Limiting & Account Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
